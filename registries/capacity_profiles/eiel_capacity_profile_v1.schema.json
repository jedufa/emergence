{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causyl.local/schemas/eiel_capacity_profile_v1.schema.json",
  "title": "EIEL Capacity Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id"],
  "properties": {
    "schema_version": {"const": "eiel_capacity_profile_v1"},
    "profile_id": {"$ref": "#/$defs/id"},
    "description": {"type": "string"},
    "build": {"$ref": "#/$defs/build"},
    "paths": {"$ref": "#/$defs/paths"},
    "validation": {"$ref": "#/$defs/validation"},
    "campaign": {"$ref": "#/$defs/campaign"},
    "benchmark": {"$ref": "#/$defs/benchmark"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"max_jobs": {"type": "integer", "minimum": 1, "maximum": 256}}
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime_root": {"type": "string", "pattern": "^/"},
        "artifact_root": {"type": "string", "pattern": "^/"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel_steps": {"type": "integer", "minimum": 1, "maximum": 256},
        "capture_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "failure_policy": {"enum": ["continue", "fail_fast"]}
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"workers": {"type": "integer", "minimum": 1, "maximum": 256}}
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_cells": {"type": "integer", "minimum": 1, "maximum": 65536},
        "warmups": {"type": "integer", "minimum": 0, "maximum": 1000},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 10000},
        "device_selector": {
          "type": "string",
          "pattern": "^(?:cpu|auto|cuda:[0-9]+|uuid:[A-Za-z0-9][A-Za-z0-9._:+-]{0,127})$"
        },
        "objective": {"enum": ["correctness", "latency", "throughput"]},
        "memory_headroom_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    }
  }
}
