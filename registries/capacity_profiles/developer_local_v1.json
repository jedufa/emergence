{
  "schema_version": "eiel_capacity_profile_v1",
  "profile_id": "developer-local-v1",
  "description": "Moderate local-development capacity without machine-specific paths.",
  "build": {"max_jobs": 4},
  "paths": {
    "runtime_root": "/tmp/eiel-developer-runtime",
    "artifact_root": "/tmp/eiel-developer-artifacts"
  },
  "validation": {
    "max_parallel_steps": 2,
    "capture_bytes": 4194304,
    "failure_policy": "fail_fast"
  },
  "campaign": {"workers": 4},
  "benchmark": {
    "batch_cells": 4,
    "warmups": 1,
    "repetitions": 5,
    "device_selector": "auto",
    "objective": "throughput",
    "memory_headroom_bytes": 1073741824
  }
}
