{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiel.local/schemas/eiel_raw_asset_ref_v1.schema.json",
  "title": "EIEL Raw Asset Reference V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "raw_asset_id",
    "schema_version",
    "storage_class",
    "locator_type",
    "locator",
    "expected_size_bytes",
    "sha256",
    "producing_campaign_or_run_ids",
    "source_commit",
    "provider",
    "runtime",
    "route_identity",
    "configuration_receipt",
    "input_output_relation",
    "replica_references",
    "archive_manifest",
    "last_successful_existence_check",
    "last_successful_integrity_check",
    "restore_test_state",
    "retention_state",
    "replacement_or_tombstone"
  ],
  "properties": {
    "raw_asset_id": { "type": "string", "pattern": "^eiel-raw-[a-z0-9][a-z0-9-]{8,}$" },
    "schema_version": { "const": "eiel_raw_asset_ref_v1" },
    "storage_class": { "enum": ["runtime_active", "runtime_archive", "cold_storage", "external_repository", "missing", "unknown"] },
    "locator_type": { "enum": ["path", "uri", "archive_member", "unknown"] },
    "locator": { "type": "string", "minLength": 1 },
    "expected_size_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "producing_campaign_or_run_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "source_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "provider": { "type": ["string", "null"] },
    "runtime": { "type": ["string", "null"] },
    "route_identity": { "type": ["string", "null"] },
    "configuration_receipt": { "type": ["string", "null"] },
    "input_output_relation": { "enum": ["input", "output", "derived", "mixed", "unknown"] },
    "replica_references": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "archive_manifest": { "type": ["string", "null"] },
    "last_successful_existence_check": { "type": ["string", "null"] },
    "last_successful_integrity_check": { "type": ["string", "null"] },
    "restore_test_state": { "enum": ["passed", "failed", "not_tested", "unknown"] },
    "retention_state": { "enum": ["retain", "pruned", "retired", "missing", "unknown"] },
    "replacement_or_tombstone": { "type": ["string", "null"] }
  }
}
