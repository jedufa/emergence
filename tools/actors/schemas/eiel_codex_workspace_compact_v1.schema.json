{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiel.local/schemas/eiel_codex_workspace_compact_v1.schema.json",
  "title": "EIEL Codex Workspace Compact V1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "description"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relatedRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "record_id"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "pathList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "guidance_schema_version",
    "status",
    "reason_codes",
    "problems",
    "warnings",
    "next_actions",
    "related_records",
    "ok",
    "execution_blocked",
    "workflow_administration_required",
    "workspace"
  ],
  "properties": {
    "guidance_schema_version": {
      "const": "eiel_codex_guidance_v1"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "reason_codes": {
      "$ref": "#/$defs/stringArray"
    },
    "problems": {
      "$ref": "#/$defs/stringArray"
    },
    "warnings": {
      "$ref": "#/$defs/stringArray"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nextAction"
      }
    },
    "related_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relatedRecord"
      }
    },
    "ok": {
      "type": "boolean"
    },
    "execution_blocked": {
      "type": "boolean"
    },
    "workflow_administration_required": {
      "type": "boolean"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tooling_version",
        "repository",
        "bootstrap",
        "portfolio",
        "context_health",
        "workflow_administration",
        "references"
      ],
      "properties": {
        "schema_version": {
          "const": "eiel_codex_workspace_compact_v1"
        },
        "tooling_version": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "branch",
            "head",
            "dirty"
          ],
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string"
            },
            "head": {
              "type": "string"
            },
            "dirty": {
              "type": "boolean"
            }
          }
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_id",
            "status"
          ],
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "age_hours": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "portfolio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open_work_count",
            "resumable_session_count"
          ],
          "properties": {
            "open_work_count": {
              "type": "integer",
              "minimum": 0
            },
            "resumable_session_count": {
              "type": "integer",
              "minimum": 0
            },
            "candidate_work_ids": {
              "$ref": "#/$defs/stringArray"
            },
            "resumable_session_ids": {
              "$ref": "#/$defs/stringArray"
            }
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "work_id",
            "status"
          ],
          "properties": {
            "work_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "derived_status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "priority": {
              "type": "string"
            },
            "current_stage": {
              "type": "string"
            },
            "current_step": {
              "type": "string"
            },
            "next_action": {
              "type": "string"
            },
            "next_command": {
              "type": "string"
            },
            "package": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "package_version": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "recommended_authority": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "recommended_model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "uncertainty_class": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "session_id",
            "status",
            "work_id",
            "role"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "work_id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "task_context": {
          "type": "object",
          "additionalProperties": true
        },
        "initial_context": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "entry_files": {
              "$ref": "#/$defs/pathList"
            },
            "required_documents": {
              "$ref": "#/$defs/pathList"
            },
            "search_roots": {
              "$ref": "#/$defs/pathList"
            },
            "excluded_roots": {
              "$ref": "#/$defs/pathList"
            },
            "known_symbols": {
              "$ref": "#/$defs/stringArray"
            },
            "maximum_initial_files": {
              "type": "integer",
              "minimum": 0
            },
            "broad_search_allowed": {
              "type": "boolean"
            }
          }
        },
        "initial_context_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "file_count",
            "existing_file_count",
            "total_bytes",
            "total_lines",
            "largest_files"
          ],
          "properties": {
            "status": {
              "enum": [
                "WITHIN_ADVISORY_RANGE",
                "ADVISORY_WARNING"
              ]
            },
            "file_count": {
              "type": "integer",
              "minimum": 0
            },
            "existing_file_count": {
              "type": "integer",
              "minimum": 0
            },
            "total_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "total_lines": {
              "type": "integer",
              "minimum": 0
            },
            "largest_files": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "missing_files": {
              "$ref": "#/$defs/pathList"
            },
            "invalid_paths": {
              "$ref": "#/$defs/pathList"
            }
          }
        },
        "output_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "context_health": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "handoff_recommended"
          ],
          "properties": {
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "handoff_recommended": {
              "type": "boolean"
            },
            "reasons": {
              "$ref": "#/$defs/stringArray"
            }
          }
        },
        "context_receipt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "receipt_id": {
              "type": "string"
            },
            "receipt_sha256": {
              "type": "string"
            },
            "valid": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "errors": {
              "$ref": "#/$defs/stringArray"
            },
            "warnings": {
              "$ref": "#/$defs/stringArray"
            }
          }
        },
        "workflow_administration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_for_operator_authorized_execution",
            "obligations"
          ],
          "properties": {
            "required_for_operator_authorized_execution": {
              "const": false
            },
            "obligations": {
              "$ref": "#/$defs/stringArray"
            }
          }
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_view_command"
          ],
          "properties": {
            "full_view_command": {
              "type": "string",
              "minLength": 1
            },
            "full_output_path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "execution_budget": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
