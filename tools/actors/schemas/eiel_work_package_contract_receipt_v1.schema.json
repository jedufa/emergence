{
  "$id": "https://eiel.local/schemas/eiel_work_package_contract_receipt_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Documented EIEL contract for eiel_work_package_contract_receipt_v1. Runtime loaders remain authoritative for semantic invariants.",
  "properties": {
    "contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "package": {
      "type": "object"
    },
    "schema_version": {
      "const": "eiel_work_package_contract_receipt_v1"
    }
  },
  "required": [
    "schema_version",
    "contract_sha256",
    "document_sha256",
    "package"
  ],
  "title": "EIEL Work Package Contract Receipt V1",
  "type": "object",
  "x-eiel-owner": "tools.actors.work_package",
  "x-eiel-persistence-class": "immutable_durable_receipt"
}
