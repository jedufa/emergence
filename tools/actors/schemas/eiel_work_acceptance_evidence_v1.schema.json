{
  "$id": "https://eiel.local/schemas/eiel_work_acceptance_evidence_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Documented EIEL contract for eiel_work_acceptance_evidence_v1. Runtime loaders remain authoritative for semantic invariants.",
  "properties": {
    "accepted_review": {
      "$ref": "eiel_actor_record_ref_v1.schema.json"
    },
    "decision_snapshot": {
      "type": "object"
    },
    "implementation": {
      "$ref": "eiel_actor_record_ref_v1.schema.json"
    },
    "recorded_at_utc": {
      "type": "string"
    },
    "reviewed_commit": {
      "type": "string"
    },
    "schema_version": {
      "const": "eiel_work_acceptance_evidence_v1"
    },
    "work_package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "EIEL Work Acceptance Evidence V1",
  "type": "object",
  "x-eiel-owner": "tools.actors.work_manager",
  "x-eiel-persistence-class": "embedded_durable_review_metadata"
}
