{
  "$id": "https://eiel.local/schemas/eiel_environment_fingerprint_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Documented EIEL contract for eiel_environment_fingerprint_v1. Runtime loaders remain authoritative for semantic invariants.",
  "properties": {
    "fingerprint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "packages": {
      "type": "object"
    },
    "platform": {
      "type": "object"
    },
    "python": {
      "type": "object"
    },
    "schema_version": {
      "const": "eiel_environment_fingerprint_v1"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "EIEL Environment Fingerprint V1",
  "type": "object",
  "x-eiel-owner": "tools.actors.bootstrap",
  "x-eiel-persistence-class": "nested_durable_receipt"
}
