{
  "$id": "https://eiel.local/schemas/eiel_context_evidence_artifact_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Documented contract for eiel_context_evidence_artifact_v1; runtime validators remain authoritative.",
  "properties": {
    "kind": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "schema_version": {
      "const": "eiel_context_evidence_artifact_v1"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "EIEL Context Evidence Artifact V1",
  "type": "object",
  "x-eiel-owner": "tools.actors.context_receipt",
  "x-eiel-persistence-class": "embedded_content_addressed_evidence"
}
