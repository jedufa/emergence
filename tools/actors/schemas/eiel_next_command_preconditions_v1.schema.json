{
  "$id": "https://eiel.local/schemas/eiel_next_command_preconditions_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Documented EIEL contract for eiel_next_command_preconditions_v1. Runtime loaders remain authoritative for semantic invariants.",
  "properties": {
    "authority": {
      "type": "object"
    },
    "bootstrap": {
      "type": "object"
    },
    "command_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "context_epoch": {
      "type": "object"
    },
    "repository": {
      "type": "object"
    },
    "schema_version": {
      "const": "eiel_next_command_preconditions_v1"
    },
    "session": {
      "type": "object"
    },
    "work": {
      "type": "object"
    },
    "work_package": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "command_sha256"
  ],
  "title": "EIEL Next Command Preconditions V1",
  "type": "object",
  "x-eiel-owner": "tools.actors.session_manager",
  "x-eiel-persistence-class": "embedded_durable_recovery_contract"
}
