{
  "$id": "https://eiel.local/schemas/eiel_review_obligation_proof_artifact_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "implementation_sufficiency": {
      "const": "SUFFICIENT"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "obligation_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_refs": {
            "items": {
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "uri",
                    "sha256"
                  ]
                },
                {
                  "required": [
                    "path",
                    "sha256"
                  ]
                }
              ],
              "properties": {
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "uri": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "execution_receipt": {
            "oneOf": [
              {
                "$ref": "eiel_review_execution_receipt_v1.schema.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "acceptance_criterion",
              "test",
              "evidence_item"
            ]
          },
          "obligation": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "kind",
          "obligation",
          "status",
          "evidence_refs",
          "execution_receipt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "recorded_at_utc": {
      "minLength": 1,
      "type": "string"
    },
    "review_session_id": {
      "minLength": 1,
      "type": "string"
    },
    "reviewed_commit": {
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "reviewed_package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "eiel_review_obligation_proof_artifact_v1"
    },
    "source_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "work_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "work_id",
    "review_session_id",
    "reviewed_commit",
    "reviewed_package_sha256",
    "implementation_sufficiency",
    "obligation_results",
    "limitations",
    "source_document_sha256",
    "recorded_at_utc",
    "artifact_sha256"
  ],
  "title": "EIEL retained evidence-entailing review proof",
  "type": "object",
  "x-eiel-owner": "tools.actors.acceptance",
  "x-eiel-persistence-class": "immutable_durable_review_evidence"
}
