{
  "$id": "https://eiel.local/schemas/eiel_work_terminal_decision_receipt_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "eiel_work_terminal_decision_receipt_v1"},
    "artifact_id": {"minLength": 1, "type": "string"},
    "artifact_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "work_id": {"pattern": "^WORK-", "type": "string"},
    "pre_terminal_work": {"$ref": "eiel_actor_record_ref_v1.schema.json"},
    "work_contract": {"type": "object"},
    "terminal_decision": {"type": "object"},
    "acceptance_evidence": {"type": ["object", "null"]},
    "repository_integration_receipt": {"type": ["object", "null"]},
    "qualification_decision": {"type": ["object", "null"]},
    "dependency_state": {"type": ["object", "null"]},
    "deciding_authority": {"type": "object"},
    "recorded_at_utc": {"minLength": 1, "type": "string"}
  },
  "required": [
    "schema_version", "artifact_id", "artifact_sha256", "work_id",
    "pre_terminal_work", "work_contract", "terminal_decision",
    "acceptance_evidence", "repository_integration_receipt",
    "qualification_decision", "dependency_state", "deciding_authority",
    "recorded_at_utc"
  ],
  "title": "EIEL immutable Work terminal decision receipt V1",
  "type": "object",
  "x-eiel-owner": "tools.actors.work_manager",
  "x-eiel-persistence-class": "immutable_content_addressed_terminal_decision"
}
