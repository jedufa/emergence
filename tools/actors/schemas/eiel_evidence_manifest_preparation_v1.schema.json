{
  "$id": "https://eiel.local/schemas/eiel_evidence_manifest_preparation_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Documented EIEL contract for eiel_evidence_manifest_preparation_v1. Runtime loaders remain authoritative for semantic invariants.",
  "properties": {
    "inferred_config_count": {
      "minimum": 0,
      "type": "integer"
    },
    "metrics_file_count": {
      "minimum": 0,
      "type": "integer"
    },
    "no_silent_guessing": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "eiel_evidence_manifest_preparation_v1"
    },
    "status": {
      "type": "string"
    },
    "unresolved_fields": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "validation_errors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "status",
    "unresolved_fields",
    "validation_errors",
    "no_silent_guessing"
  ],
  "title": "EIEL Evidence Manifest Preparation V1",
  "type": "object",
  "x-eiel-owner": "tools.actors.evidence_manager",
  "x-eiel-persistence-class": "embedded_persisted_preparation"
}
