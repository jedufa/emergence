{
  "$id": "https://eiel.local/schemas/eiel_codex_workspace_handoff_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "bootstrap": {
      "type": "object"
    },
    "bridge": {
      "type": "object"
    },
    "context_health": {
      "type": [
        "object",
        "null"
      ]
    },
    "context_receipt": {
      "type": [
        "object",
        "null"
      ]
    },
    "execution_budget": {
      "type": [
        "object",
        "null"
      ]
    },
    "generated_at_utc": {
      "type": "string"
    },
    "handoff_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "initial_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "mission": {
      "type": [
        "object",
        "null"
      ]
    },
    "next_action": {
      "type": "object"
    },
    "operator_contract_version": {
      "const": "eiel_codex_operator_contract_v1"
    },
    "output_policy": {
      "type": [
        "object",
        "null"
      ]
    },
    "record_hashes": {
      "type": "object"
    },
    "repository": {
      "type": "object"
    },
    "resume_rule": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "eiel_codex_workspace_handoff_v1"
    },
    "session": {
      "type": [
        "object",
        "null"
      ]
    },
    "task_context": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_task_mode": {
          "enum": [
            "review",
            "diagnosis",
            "implementation",
            "campaign",
            "qualification",
            "documentation",
            "evidence",
            "mechanical"
          ],
          "type": "string"
        },
        "qualification_reason": {
          "type": "string"
        },
        "qualification_required": {
          "type": "boolean"
        },
        "qualification_status": {
          "minLength": 1,
          "type": "string"
        },
        "required_authority_domain": {
          "minLength": 1,
          "type": "string"
        },
        "required_session_role": {
          "enum": [
            "ARCHITECTURE_AUTHORITY",
            "ENGINEERING_AUTHORITY",
            "IMPLEMENTATION_AUTHORITY",
            "REVIEW_AUTHORITY"
          ],
          "type": "string"
        },
        "task_class": {
          "enum": [
            "review",
            "diagnosis",
            "implementation",
            "campaign",
            "qualification",
            "documentation",
            "evidence",
            "repository_maintenance"
          ],
          "type": "string"
        }
      },
      "required": [
        "bootstrap_task_mode",
        "task_class",
        "required_authority_domain",
        "required_session_role",
        "qualification_required",
        "qualification_status",
        "qualification_reason"
      ],
      "type": "object"
    },
    "tooling_version": {
      "type": "string"
    },
    "work": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "operator_contract_version",
    "tooling_version",
    "generated_at_utc",
    "repository",
    "bootstrap",
    "next_action",
    "resume_rule",
    "record_hashes",
    "task_context",
    "handoff_sha256"
  ],
  "title": "EIEL consolidated Codex resume handoff",
  "type": "object"
}
