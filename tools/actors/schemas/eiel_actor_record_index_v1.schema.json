{
  "$id": "https://eiel.local/schemas/eiel_actor_record_index_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Documented EIEL contract for eiel_actor_record_index_v1. Runtime loaders remain authoritative for semantic invariants.",
  "properties": {
    "index_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "records": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "eiel_actor_record_index_v1"
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "record_count",
    "records",
    "index_sha256"
  ],
  "title": "EIEL Actor Record Index V1",
  "type": "object",
  "x-eiel-owner": "tools.actors.store",
  "x-eiel-persistence-class": "durable_derived_index"
}
