{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiel.local/schemas/eiel_runability_closure_v1.schema.json",
  "title": "Runability Closure V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "run_root",
    "decision",
    "checks",
    "failure_class",
    "reasons",
    "created_at_utc",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "eiel_runability_closure_v1"},
    "release_id": {"type": "string"},
    "run_root": {"type": "string"},
    "decision": {"enum": ["RUNABILITY_CLOSED", "RUNABILITY_NOT_CLOSED"]},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "failure_class": {
      "type": ["string", "null"],
      "enum": [
        null,
        "QRR_BUILD_FAILURE",
        "QRR_INTEGRITY_FAILURE",
        "RUNABILITY_CONTRACT_FAILURE",
        "QRR_REPRESENTABILITY_BLOCKED",
        "RESOURCE_BLOCKED",
        "CAPABILITY_BLOCKED",
        "ENVIRONMENT_BLOCKED",
        "CHECKPOINT_RESUME_BLOCKED",
        "POST_QUALIFICATION_RUNABILITY_ESCAPE",
        "SCIENCE_DESIGN_BLOCKED"
      ]
    },
    "reasons": {"type": "array", "items": {"type": "string"}},
    "created_at_utc": {"type": "string"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
