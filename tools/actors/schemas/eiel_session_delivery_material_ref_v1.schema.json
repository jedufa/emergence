{
  "$id": "https://eiel.local/schemas/eiel_session_delivery_material_ref_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "delivery_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identity_assurance": {
      "additionalProperties": true,
      "type": "object"
    },
    "implementation_commit": {
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "implementation_session_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "eiel_session_delivery_material_ref_v1"
    },
    "terminal_outcome": {
      "minLength": 1,
      "type": "string"
    },
    "work_package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "work_package_version": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "implementation_session_id",
    "terminal_outcome",
    "delivery_evidence_sha256",
    "implementation_commit",
    "work_package_sha256",
    "work_package_version",
    "identity_assurance"
  ],
  "title": "EIEL material delivery identity for review freshness",
  "type": "object",
  "x-eiel-owner": "tools.actors.session_manager",
  "x-eiel-persistence-class": "embedded_material_reference"
}
