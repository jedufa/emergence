{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiel.local/schemas/eiel_work_hold_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "eiel_work_hold_v1"},
    "kind": {"enum": ["REVIEW_DEFERRED", "RESOURCE_WAIT", "OPERATOR_DECISION"]},
    "reason": {"type": "string", "minLength": 1},
    "authority": {"type": "object", "additionalProperties": true},
    "created_at_utc": {"type": "string"},
    "resume_condition": {"type": "string", "minLength": 1},
    "resume_after_utc": {"type": ["string", "null"]}
  },
  "required": ["schema_version", "kind", "reason", "authority", "created_at_utc", "resume_condition", "resume_after_utc"]
}
