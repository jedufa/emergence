{
  "schema_version": "eiel_recurrent_state_capacity_epoch_manifest_v1",
  "contract_id": "stable_gru_v1_plus_modular_recurrent_v1",
  "precision": {
    "storage": "float32",
    "compute": "float32",
    "comparison": {
      "stable_gru_cpu": {"rtol": 0.0, "atol": 5e-7},
      "sequence": {"rtol": 0.0, "atol": 2e-6},
      "integer_and_lifecycle": "exact"
    },
    "ambiguity": "The nn.GRUCell scalar module and production batched bmm graph are semantically equivalent but are not bit-identical on CPU; the batched graph is authoritative."
  },
  "stable_gru": {
    "hidden_width": 64,
    "memory_ladder": [0, 8, 16, 32, 64],
    "gate_order": ["reset", "update", "new"],
    "equations": [
      "encoded=tanh(encW*observation+encb)",
      "input_projection=Wih*encoded+bih",
      "hidden_projection=Whh*h_prev+bhh",
      "reset=sigmoid(input_reset+hidden_reset)",
      "update=sigmoid(input_update+hidden_update)",
      "new=tanh(input_new+reset*hidden_new)",
      "h_next=(1-update)*new+update*h_prev",
      "logits=headW*h_next+headb"
    ],
    "packed_parameter_order": ["encW", "encb", "Wih", "bih", "Whh", "bhh", "headW", "headb"],
    "packed_width_formula": "H*O+H+3*H*H+3*H+3*H*H+3*H+A*H+A",
    "mask": "Prefix mask index < effective_memory_dim is applied to h_prev before the cell and h_next before commit.",
    "partition": "Rows retain alive/refill order within each MLP/GRU partition; stride misses are sorted by agent_id before partitioning.",
    "rng": {
      "stride_one": "MLP [rows,actions] then GRU [rows,actions] from torch policy stream",
      "stride_many": "MLP [rows,stride,actions] then GRU [rows,actions] from policy_np; GRU action is repeated",
      "deterministic": "argmax and zero policy draws"
    },
    "lifecycle": {
      "founder": "zero hidden row",
      "newborn": "zero hidden row after parameter-bank sync",
      "inheritance": "controller parameters may be inherited; runtime hidden state is never inherited",
      "death": "dead row becomes unreachable; stale bytes may remain until slot reuse",
      "slot_reuse": "slot-token mismatch synchronizes parameters and zeros hidden row",
      "tick_commit": "hidden state commits after forward and before action sampling",
      "failure": "compute failure commits nothing; failure after hidden commit does not roll back",
      "cancellation": "checked at tick boundary before policy execution"
    },
    "checkpoint": {
      "authoritative": ["_Hmem", "_gru_hidden", "_gru_inited", "policy stride action sequence", "policy stride token", "policy stride cursor"],
      "cache_only": ["_gru_pack", "per-field GRU parameter banks", "_policy_tick_cache"],
      "continuation": "Fresh owner rebuilds parameter banks, restores Hmem, and preserves valid stride-cache rows."
    },
    "cost": {
      "formula": "max(0, gru_cost_base + gru_cost_per_dim * effective_memory_dim)",
      "default_base": 0.004,
      "default_per_dim": 0.00008,
      "charge_point": "environment apply after recurrent forward"
    }
  },
