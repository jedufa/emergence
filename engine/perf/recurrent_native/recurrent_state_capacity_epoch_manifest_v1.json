    "checkpoint": {"canonical_authority": ["profile", "capacity_epoch_id and generation", "stable identities and ancestry", "module_execution_order", "operators and parameters", "distinct masks", "routing and connections", "module state and previous output", "development explicit/latch/effective gain planes"], "sort_before_digest": true, "fresh_owner_continuation": "project canonical owner, restore only into empty fresh owner, then continue next tick exactly"},
