{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eiel:adaptive-science-expedition:v1:contracts",
  "title": "EIEL Adaptive Science Expedition durable contracts V1",
  "description": "Strict route-neutral G1 contracts. Scientific time appears only as explicit absolute-tick cursors; frontier_ordinal is outer journal ordering.",
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/observationFrame"},
    {"$ref": "#/$defs/stateRef"},
    {"$ref": "#/$defs/decision"},
    {"$ref": "#/$defs/generatedChildContinuation"},
    {"$ref": "#/$defs/journalRecord"},
    {"$ref": "#/$defs/evolutionaryAtlas"},
    {"$ref": "#/$defs/retainedParentBank"}
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f]+$"
    },
    "schemaToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hex"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "optionalDigest": {
      "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "canonicalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "payload"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schemaToken"},
        "payload": true
      }
    },
    "expeditionLifecyclePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "payload"],
      "properties": {
        "schema_version": {"const": "eiel_adaptive_expedition_lifecycle_policy_v1"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "child_contract_class",
            "lifecycle_authority",
            "outer_contract",
            "retention_authority_created"
          ],
          "properties": {
            "child_contract_class": {
              "enum": ["CHECKPOINT_TRANSIT", "SCIENCE_COMPACT", "DEBUG_FORENSIC"]
            },
            "lifecycle_authority": {"const": "canonical_run_artifact_lifecycle"},
            "outer_contract": {
              "type": "object",
              "required": ["schema_version", "lifecycle_profile", "contract_sha256"],
              "properties": {
                "schema_version": {"const": "eiel_run_artifact_lifecycle_contract_v1"},
                "lifecycle_profile": {"const": "SCIENCE_COMPACT"},
                "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "retention_authority_created": {"const": false}
          }
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_kind",
        "artifact_schema_version",
        "locator",
        "content_digest",
        "size_bytes"
      ],
      "properties": {
        "schema_version": {"const": "run_artifact_ref_v1"},
        "artifact_id": {"$ref": "#/$defs/text"},
        "artifact_kind": {"$ref": "#/$defs/text"},
        "artifact_schema_version": {"$ref": "#/$defs/schemaToken"},
        "locator": {"$ref": "#/$defs/text"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "size_bytes": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            {"type": "null"}
          ]
        }
      }
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "implementation_sha256",
        "profile_sha256",
        "profile"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/text"},
        "policy_version": {"$ref": "#/$defs/text"},
        "implementation_sha256": {"$ref": "#/$defs/digest"},
        "profile_sha256": {"$ref": "#/$defs/digest"},
        "profile": {"$ref": "#/$defs/canonicalPayload"}
      }
    },
    "stateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expedition_id",
        "world_trajectory_id",
        "logical_world_id",
        "next_absolute_tick",
        "state_class",
        "semantic_world_sha256",
        "control_history_sha256",
        "source_object_sha256",
        "source_artifact_ref",
        "exact_state_sha256",
        "checkpoint_occurrence_sha256",
        "rng_state_sha256",
        "event_prefix_sha256",
        "parent_occurrence_sha256",
        "replay_recipe_sha256"
      ],
      "properties": {
        "schema_version": {"const": "eiel_adaptive_science_state_ref_v1"},
        "expedition_id": {"$ref": "#/$defs/text"},
        "world_trajectory_id": {"$ref": "#/$defs/text"},
        "logical_world_id": {"type": "integer", "minimum": 0},
        "next_absolute_tick": {"type": "integer", "minimum": 0},
        "state_class": {
          "enum": [
            "OBSERVATION_ONLY",
            "BRANCHABLE_EXACT",
            "REPLAY_DERIVABLE",
            "TERMINAL_ONLY"
          ]
        },
        "semantic_world_sha256": {"$ref": "#/$defs/digest"},
        "control_history_sha256": {"$ref": "#/$defs/digest"},
        "source_object_sha256": {"$ref": "#/$defs/digest"},
        "source_artifact_ref": {"$ref": "#/$defs/artifactRef"},
        "exact_state_sha256": {"$ref": "#/$defs/optionalDigest"},
        "checkpoint_occurrence_sha256": {"$ref": "#/$defs/optionalDigest"},
        "rng_state_sha256": {"$ref": "#/$defs/optionalDigest"},
        "event_prefix_sha256": {"$ref": "#/$defs/optionalDigest"},
        "parent_occurrence_sha256": {"$ref": "#/$defs/optionalDigest"},
        "replay_recipe_sha256": {"$ref": "#/$defs/optionalDigest"}
      },
      "allOf": [
        {
          "if": {"properties": {"state_class": {"const": "BRANCHABLE_EXACT"}}},
          "then": {
            "properties": {
              "exact_state_sha256": {"$ref": "#/$defs/digest"},
              "checkpoint_occurrence_sha256": {"$ref": "#/$defs/digest"},
              "rng_state_sha256": {"$ref": "#/$defs/digest"},
              "event_prefix_sha256": {"$ref": "#/$defs/digest"},
              "parent_occurrence_sha256": {"$ref": "#/$defs/digest"},
              "replay_recipe_sha256": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"state_class": {"const": "REPLAY_DERIVABLE"}}},
          "then": {
            "properties": {
              "exact_state_sha256": {"$ref": "#/$defs/digest"},
              "checkpoint_occurrence_sha256": {"$ref": "#/$defs/digest"},
              "rng_state_sha256": {"$ref": "#/$defs/digest"},
              "event_prefix_sha256": {"$ref": "#/$defs/digest"},
              "parent_occurrence_sha256": {"$ref": "#/$defs/digest"},
              "replay_recipe_sha256": {"$ref": "#/$defs/digest"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "state_class": {"enum": ["OBSERVATION_ONLY", "TERMINAL_ONLY"]}
            }
          },
          "then": {
            "properties": {
              "exact_state_sha256": {"type": "null"},
              "checkpoint_occurrence_sha256": {"type": "null"},
              "rng_state_sha256": {"type": "null"},
              "event_prefix_sha256": {"type": "null"},
              "parent_occurrence_sha256": {"type": "null"},
              "replay_recipe_sha256": {"type": "null"}
            }
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expedition_id",
        "question_description",
        "no_claims",
        "hypothesis_ids",
        "required_science_instrument",
        "founder_basis_refs",
        "search_space",
        "epoch_ticks",
        "maximum_absolute_tick",
        "maximum_frontiers",
        "maximum_actions_per_frontier",
        "wall_time_budget_seconds",
        "observation_profile_id",
        "observation_descriptor_set_sha256",
        "policy_binding",
        "outer_search_seed",
        "maximum_atlas_entries",
        "maximum_retained_parent_entries",
        "maximum_retained_parent_bytes",
        "artifact_lifecycle_policy",
        "stop_conditions"
      ],
      "properties": {
        "schema_version": {"const": "eiel_adaptive_science_expedition_manifest_v1"},
        "expedition_id": {"$ref": "#/$defs/text"},
        "question_description": {"$ref": "#/$defs/text"},
        "no_claims": {"const": true},
        "hypothesis_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "required_science_instrument": {"$ref": "#/$defs/text"},
        "founder_basis_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactRef"}
        },
        "search_space": {"$ref": "#/$defs/canonicalPayload"},
        "epoch_ticks": {"type": "integer", "minimum": 1},
        "maximum_absolute_tick": {"type": "integer", "minimum": 1},
        "maximum_frontiers": {"type": "integer", "minimum": 1},
        "maximum_actions_per_frontier": {"type": "integer", "minimum": 1},
        "wall_time_budget_seconds": {
          "oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
        },
        "observation_profile_id": {"$ref": "#/$defs/text"},
        "observation_descriptor_set_sha256": {"$ref": "#/$defs/digest"},
        "policy_binding": {"$ref": "#/$defs/policyBinding"},
        "outer_search_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "maximum_atlas_entries": {"type": "integer", "minimum": 1},
        "maximum_retained_parent_entries": {"type": "integer", "minimum": 1},
        "maximum_retained_parent_bytes": {"type": "integer", "minimum": 1},
        "artifact_lifecycle_policy": {"$ref": "#/$defs/expeditionLifecyclePolicy"},
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "observationFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expedition_id",
        "world_trajectory_id",
        "logical_world_id",
        "next_absolute_tick",
        "semantic_world_sha256",
        "control_history_sha256",
        "observation_profile_id",
        "observation_profile_sha256",
        "observation_descriptor_set_sha256",
        "reducer_implementation_sha256",
        "observations",
        "control_readback",
        "policy_facing_facts",
        "descriptor_values",
        "calibration",
        "source_state_ref",
        "previous_frame_sha256"
      ],
      "properties": {
        "schema_version": {"const": "eiel_adaptive_science_observation_frame_v1"},
        "expedition_id": {"$ref": "#/$defs/text"},
        "world_trajectory_id": {"$ref": "#/$defs/text"},
        "logical_world_id": {"type": "integer", "minimum": 0},
        "next_absolute_tick": {"type": "integer", "minimum": 0},
        "semantic_world_sha256": {"$ref": "#/$defs/digest"},
        "control_history_sha256": {"$ref": "#/$defs/digest"},
        "observation_profile_id": {"$ref": "#/$defs/text"},
        "observation_profile_sha256": {"$ref": "#/$defs/digest"},
        "observation_descriptor_set_sha256": {"$ref": "#/$defs/digest"},
        "reducer_implementation_sha256": {"$ref": "#/$defs/digest"},
        "observations": {"$ref": "#/$defs/canonicalPayload"},
        "control_readback": {"$ref": "#/$defs/canonicalPayload"},
        "policy_facing_facts": {"$ref": "#/$defs/canonicalPayload"},
        "descriptor_values": {"$ref": "#/$defs/canonicalPayload"},
        "calibration": {"$ref": "#/$defs/canonicalPayload"},
        "source_state_ref": {"$ref": "#/$defs/stateRef"},
        "previous_frame_sha256": {"$ref": "#/$defs/optionalDigest"}
      }
    },
    "actionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_kind",
        "quota_bucket",
        "parent_state_ref_sha256",
        "effective_next_absolute_tick",
        "next_epoch_ticks",
        "reason_codes",
        "action_payload"
      ],
      "properties": {
        "action_id": {"$ref": "#/$defs/text"},
        "action_kind": {
          "enum": [
            "CONTINUE",
            "BRANCH_LOCAL",
            "EXPLORE_GLOBAL",
            "REPLICATE",
            "CAUSAL_PROBE",
            "TRANSFER_CHALLENGE",
            "REQUEST_DETAILED_OBSERVATION",
            "PARK",
            "RETIRE",
            "QUARANTINE"
          ]
        },
        "quota_bucket": {"$ref": "#/$defs/text"},
        "parent_state_ref_sha256": {"$ref": "#/$defs/optionalDigest"},
        "effective_next_absolute_tick": {"type": "integer", "minimum": 0},
        "next_epoch_ticks": {
          "oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "action_payload": {"$ref": "#/$defs/canonicalPayload"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action_kind": {
                "enum": ["CONTINUE", "BRANCH_LOCAL", "EXPLORE_GLOBAL", "REPLICATE", "CAUSAL_PROBE", "TRANSFER_CHALLENGE"]
              }
            }
          },
          "then": {"properties": {"next_epoch_ticks": {"type": "integer", "minimum": 1}}},
          "else": {"properties": {"next_epoch_ticks": {"type": "null"}}}
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expedition_id",
        "frontier_ordinal",
        "manifest_sha256",
        "observation_frontier_sha256",
        "atlas_before_sha256",
        "policy_implementation_sha256",
        "policy_profile_sha256",
        "outer_rng_before_sha256",
        "outer_rng_after_sha256",
        "policy_proposal",
        "policy_proposal_sha256",
        "action_rows",
        "integrity_warnings"
      ],
      "properties": {
        "schema_version": {"const": "eiel_adaptive_science_decision_v1"},
        "expedition_id": {"$ref": "#/$defs/text"},
        "frontier_ordinal": {"type": "integer", "minimum": 0},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "observation_frontier_sha256": {"$ref": "#/$defs/digest"},
        "atlas_before_sha256": {"$ref": "#/$defs/digest"},
        "policy_implementation_sha256": {"$ref": "#/$defs/digest"},
        "policy_profile_sha256": {"$ref": "#/$defs/digest"},
        "outer_rng_before_sha256": {"$ref": "#/$defs/digest"},
        "outer_rng_after_sha256": {"$ref": "#/$defs/digest"},
        "policy_proposal": {"$ref": "#/$defs/canonicalPayload"},
        "policy_proposal_sha256": {"$ref": "#/$defs/digest"},
        "action_rows": {"type": "array", "items": {"$ref": "#/$defs/actionRow"}},
        "integrity_warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "generatedChildContinuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expedition_id",
        "manifest_sha256",
        "decision_sha256",
        "action_id",
        "action_kind",
        "realization_kind",
        "parent_state_ref",
        "founder_basis_sha256",
        "child_trajectory_id",
        "child_run_id",
        "retry_of_run_id",
        "effective_next_absolute_tick",
        "control_schedule_sha256",
        "child_request",
        "child_request_sha256"
      ],
      "properties": {
        "schema_version": {"const": "eiel_adaptive_science_generated_child_continuation_v1"},
        "expedition_id": {"$ref": "#/$defs/text"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "decision_sha256": {"$ref": "#/$defs/digest"},
        "action_id": {"$ref": "#/$defs/text"},
        "action_kind": {
          "enum": ["CONTINUE", "BRANCH_LOCAL", "EXPLORE_GLOBAL", "REPLICATE", "CAUSAL_PROBE", "TRANSFER_CHALLENGE"]
        },
        "realization_kind": {"enum": ["FOUNDER_BASIS_REQUEST", "EXACT_STATE_REQUEST"]},
        "parent_state_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/stateRef"}
          ]
        },
        "founder_basis_sha256": {"$ref": "#/$defs/digest"},
        "child_trajectory_id": {"$ref": "#/$defs/text"},
        "child_run_id": {"$ref": "#/$defs/text"},
        "retry_of_run_id": {"type": "null"},
        "effective_next_absolute_tick": {"type": "integer", "minimum": 0},
        "control_schedule_sha256": {"$ref": "#/$defs/digest"},
        "child_request": {"$ref": "#/$defs/canonicalPayload"},
        "child_request_sha256": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {"properties": {"realization_kind": {"const": "FOUNDER_BASIS_REQUEST"}}},
          "then": {
            "properties": {
              "effective_next_absolute_tick": {"const": 0},
              "parent_state_ref": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "parent_state_ref": {
                "type": "object",
                "properties": {"state_class": {"enum": ["BRANCHABLE_EXACT", "REPLAY_DERIVABLE"]}}
              }
            }
          }
        }
      ]
    },
    "journalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expedition_id",
        "record_sequence",
        "frontier_ordinal",
        "record_kind",
        "manifest_sha256",
        "subject_sha256",
        "payload",
        "payload_sha256",
        "previous_record_sha256"
      ],
      "properties": {
        "schema_version": {"const": "eiel_adaptive_science_journal_record_v1"},
        "expedition_id": {"$ref": "#/$defs/text"},
        "record_sequence": {"type": "integer", "minimum": 0},
        "frontier_ordinal": {"type": "integer", "minimum": 0},
        "record_kind": {
          "enum": [
            "OBSERVATION_ACCEPTED",
            "DECISION_COMMITTED",
            "CHILD_REQUEST_GENERATED",
            "ATLAS_UPDATED",
            "PARENT_BANK_UPDATED",
            "FRONTIER_SETTLED",
            "EXPEDITION_TERMINATED",
            "INTEGRITY_FAILURE"
          ]
        },
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "subject_sha256": {"$ref": "#/$defs/digest"},
        "payload": {"$ref": "#/$defs/canonicalPayload"},
        "payload_sha256": {"$ref": "#/$defs/digest"},
        "previous_record_sha256": {"$ref": "#/$defs/optionalDigest"}
      },
      "allOf": [
        {
          "if": {"properties": {"record_sequence": {"const": 0}}},
          "then": {"properties": {"previous_record_sha256": {"type": "null"}}},
          "else": {"properties": {"previous_record_sha256": {"$ref": "#/$defs/digest"}}}
        }
      ]
    },
    "atlasEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atlas_entry_id",
        "world_trajectory_id",
        "observation_frame_sha256",
        "state_ref_sha256",
        "niche_key",
        "descriptor_values",
        "policy_facing_facts",
        "representative_roles",
        "parent_entry_ids"
      ],
      "properties": {
        "atlas_entry_id": {"$ref": "#/$defs/text"},
        "world_trajectory_id": {"$ref": "#/$defs/text"},
        "observation_frame_sha256": {"$ref": "#/$defs/digest"},
        "state_ref_sha256": {"$ref": "#/$defs/optionalDigest"},
        "niche_key": {"$ref": "#/$defs/canonicalPayload"},
        "descriptor_values": {"$ref": "#/$defs/canonicalPayload"},
        "policy_facing_facts": {"$ref": "#/$defs/canonicalPayload"},
        "representative_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "parent_entry_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "evolutionaryAtlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expedition_id",
        "manifest_sha256",
        "revision",
        "through_frontier_ordinal",
        "descriptor_set_sha256",
        "maximum_entries",
        "entries",
        "previous_atlas_sha256"
      ],
      "properties": {
        "schema_version": {"const": "eiel_adaptive_science_evolutionary_atlas_v1"},
        "expedition_id": {"$ref": "#/$defs/text"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "revision": {"type": "integer", "minimum": 0},
        "through_frontier_ordinal": {"type": "integer", "minimum": 0},
        "descriptor_set_sha256": {"$ref": "#/$defs/digest"},
        "maximum_entries": {"type": "integer", "minimum": 1},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/atlasEntry"}},
        "previous_atlas_sha256": {"$ref": "#/$defs/optionalDigest"}
      },
      "allOf": [
        {
          "if": {"properties": {"revision": {"const": 0}}},
          "then": {"properties": {"previous_atlas_sha256": {"type": "null"}}},
          "else": {"properties": {"previous_atlas_sha256": {"$ref": "#/$defs/digest"}}}
        }
      ]
    },
    "retainedParentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_ref",
        "selected_at_frontier_ordinal",
        "reason_codes",
        "retained_bytes"
      ],
      "properties": {
        "state_ref": {
          "allOf": [
            {"$ref": "#/$defs/stateRef"},
            {"properties": {"state_class": {"enum": ["BRANCHABLE_EXACT", "REPLAY_DERIVABLE"]}}}
          ]
        },
        "selected_at_frontier_ordinal": {"type": "integer", "minimum": 0},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "retained_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "retainedParentBank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expedition_id",
        "manifest_sha256",
        "revision",
        "maximum_entries",
        "maximum_total_bytes",
        "current_entry_count",
        "current_total_bytes",
        "entries",
        "previous_bank_sha256"
      ],
      "properties": {
        "schema_version": {"const": "eiel_adaptive_science_retained_parent_bank_v1"},
        "expedition_id": {"$ref": "#/$defs/text"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "revision": {"type": "integer", "minimum": 0},
        "maximum_entries": {"type": "integer", "minimum": 1},
        "maximum_total_bytes": {"type": "integer", "minimum": 1},
        "current_entry_count": {"type": "integer", "minimum": 0},
