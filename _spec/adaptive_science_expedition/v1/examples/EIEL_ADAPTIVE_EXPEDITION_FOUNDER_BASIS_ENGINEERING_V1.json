  },
  "world": {
    "width": 32,
    "height": 32,
    "population": 256,
    "capacity": 512
  },
  "run": {
    "ticks": 64,
    "batch": 1,
    "checkpoint_ticks": [
      64
    ]
  },
  "dimensions": {
    "condition": [
      1
    ],
    "replicate": [
      7
    ],
    "seed": [
      1103
    ]
  },
  "world_template": {
    "initialization": {
      "initial_population": 256,
      "initial_live_count": 256,
      "founder_profiles": [
        "native-broad-diverse-a-v1"
