{
  "schema_version": "eiel_science_request_v1",
  "campaign_id": "EIEL-ADAPTIVE-EXPEDITION-FOUNDER-BASIS-ENGINEERING-V1",
  "test": "EIEL_ADAPTIVE_EXPEDITION_FOUNDER_BASIS_ENGINEERING_V1",
  "question": {
    "description": "Declare one immutable small founder basis for no-claims adaptive-expedition engineering validation.",
