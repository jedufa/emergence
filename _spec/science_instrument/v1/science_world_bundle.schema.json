{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eiel:science-instrument:v1:science-world-bundle",
  "title": "EIEL Science World Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "bundle_id", "instrument_contract",
    "world_count", "compact_source_specs", "compiler_component_sha256",
    "worlds", "bundle_content_sha256"
  ],
  "properties": {
    "schema": {"const": "EIEL_SCIENCE_WORLD_BUNDLE_V1"},
    "schema_version": {"const": "eiel_science_world_bundle_v1"},
    "bundle_id": {"$ref": "#/$defs/token"},
    "instrument_contract": {"const": "EIEL_SCIENCE_INSTRUMENT_V1"},
    "world_count": {"type": "integer", "minimum": 1},
    "compact_source_specs": {"type": "array", "minItems": 1},
    "compiler_component_sha256": {"$ref": "#/$defs/digest"},
    "worlds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/world"}
    },
    "bundle_content_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "token": {"type": "string", "minLength": 1},
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hex"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "science": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "test_version", "study_id", "arm_id", "replicate"],
      "properties": {
        "test_id": {"$ref": "#/$defs/token"},
        "test_version": {"$ref": "#/$defs/token"},
        "study_id": {"$ref": "#/$defs/token"},
        "arm_id": {"$ref": "#/$defs/token"},
        "replicate": {"type": ["string", "integer"]}
      }
    },
    "semantic_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world", "initialization", "dimension_bindings", "control_bindings",
        "seed_bindings", "time", "initial_state_identity"
      ],
      "properties": {
        "world": {"type": "object"},
        "initialization": {"type": "object"},
        "dimension_bindings": {"type": "object"},
        "control_bindings": {"type": "array"},
        "seed_bindings": {"type": "object", "minProperties": 1},
        "time": {"type": "object"},
        "initial_state_identity": {"$ref": "#/$defs/digest"}
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id", "event_observations", "state_observations",
        "runtime_counters", "snapshot_ticks", "windows"
      ],
      "properties": {
        "profile_id": {"$ref": "#/$defs/token"},
        "event_observations": {"type": "array", "items": {"$ref": "#/$defs/token"}, "uniqueItems": true},
        "state_observations": {"type": "array", "items": {"$ref": "#/$defs/token"}, "uniqueItems": true},
        "runtime_counters": {"type": "array", "items": {"$ref": "#/$defs/token"}, "uniqueItems": true},
        "snapshot_ticks": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "windows": {"type": "array", "items": {"type": "object"}}
      }
    },
    "reducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reducer_id", "contract_version", "required_observations",
        "output_contract_id", "configuration"
      ],
      "properties": {
        "reducer_id": {"$ref": "#/$defs/token"},
        "contract_version": {"$ref": "#/$defs/token"},
        "required_observations": {"type": "array", "items": {"$ref": "#/$defs/token"}, "uniqueItems": true},
        "output_contract_id": {"$ref": "#/$defs/token"},
        "configuration": true
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "world_id", "science", "semantic_inputs",
        "acquisition", "reducers", "identities"
      ],
      "properties": {
        "schema_version": {"const": "eiel_science_world_record_v1"},
        "world_id": {"$ref": "#/$defs/token"},
        "science": {"$ref": "#/$defs/science"},
        "semantic_inputs": {"$ref": "#/$defs/semantic_inputs"},
        "acquisition": {"$ref": "#/$defs/acquisition"},
        "reducers": {"type": "array", "items": {"$ref": "#/$defs/reducer"}},
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_world_sha256", "acquisition_sha256", "world_contract_sha256"],
          "properties": {
            "semantic_world_sha256": {"$ref": "#/$defs/digest"},
            "acquisition_sha256": {"$ref": "#/$defs/digest"},
            "world_contract_sha256": {"$ref": "#/$defs/digest"}
          }
        }
      }
    }
  }
}
