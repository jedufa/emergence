{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiel.local/schemas/eiel_science_cuda_v2_execution_plan_v1.json",
  "title": "EIEL Science Instrument CUDA V2 physical execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "carrier_family_id",
    "bundle_content_sha256",
    "bundle_admission_sha256",
    "carrier_profile_catalog_sha256",
    "logical_bundle_size",
    "execution_quantum_id",
    "fallback_policy",
    "batches",
    "physical_execution_plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": "eiel_science_cuda_v2_execution_plan_v1"},
    "carrier_family_id": {"const": "eiel_science_cuda_full_evolution_v2_carrier_family_v1"},
    "bundle_content_sha256": {"$ref": "#/$defs/digest"},
    "bundle_admission_sha256": {"$ref": "#/$defs/digest"},
    "carrier_profile_catalog_sha256": {"$ref": "#/$defs/digest"},
    "logical_bundle_size": {"type": "integer", "minimum": 1},
    "execution_quantum_id": {"type": ["string", "null"], "minLength": 1},
    "fallback_policy": {"const": "FORBIDDEN"},
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/batch"}
    },
    "physical_execution_plan_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hex"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "carrier_family_id",
        "carrier_profile_id",
        "native_shape_id",
        "provider_family",
        "provider_id",
        "native_profile_id",
        "native_route_id",
        "geometry",
        "backend_ids",
        "temporal_k_values",
        "target_physical_batch",
        "batch_is_semantic",
        "carrier_profile_sha256"
      ],
      "properties": {
        "schema_version": {"const": "eiel_science_cuda_v2_carrier_profile_v1"},
        "carrier_family_id": {"const": "eiel_science_cuda_full_evolution_v2_carrier_family_v1"},
        "carrier_profile_id": {
          "enum": [
            "w32x32p256c512_gpuv2",
            "w64x64p1024c2048_gpuv2",
            "w128x80p2560c5120_gpuv2"
          ]
        },
        "native_shape_id": {"type": "string", "pattern": "^w[0-9]+h[0-9]+p[0-9]+c[0-9]+$"},
        "provider_family": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "native_profile_id": {"type": "string", "minLength": 1},
        "native_route_id": {"type": "string", "minLength": 1},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "initial_population", "capacity"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "initial_population": {"type": "integer", "minimum": 1},
            "capacity": {"type": "integer", "minimum": 1}
          }
        },
        "backend_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "temporal_k_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "target_physical_batch": {"const": 1024},
        "batch_is_semantic": {"const": false},
        "carrier_profile_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "world_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "world_id",
        "world_uid",
        "semantic_world_sha256",
        "acquisition_sha256",
        "requested_observations",
        "world_mapping_sha256"
      ],
      "properties": {
        "schema_version": {"const": "eiel_science_cuda_v2_world_mapping_v1"},
        "world_id": {"type": "string", "minLength": 1},
        "world_uid": {"type": "integer", "minimum": 1},
        "semantic_world_sha256": {"$ref": "#/$defs/digest"},
        "acquisition_sha256": {"$ref": "#/$defs/digest"},
        "requested_observations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "native_rng_world_uid": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "native_rng_identity_sha256": {"$ref": "#/$defs/digest"},
        "native_control": {"$ref": "#/$defs/native_control"},
        "native_world_control": {"$ref": "#/$defs/native_world_control"},
        "world_mapping_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_slot", "world"],
      "properties": {
        "physical_slot": {"type": "integer", "minimum": 0},
        "world": {"$ref": "#/$defs/world_mapping"}
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "physical_batch_index",
        "carrier_profile",
        "backend_id",
        "temporal_k",
        "physical_batch_size",
        "world_slots",
        "native_observation_union",
        "physical_batch_sha256"
      ],
      "properties": {
        "schema_version": {"const": "eiel_science_cuda_v2_physical_batch_v1"},
        "physical_batch_index": {"type": "integer", "minimum": 0},
        "carrier_profile": {"$ref": "#/$defs/profile"},
        "backend_id": {"type": "string", "minLength": 1},
        "temporal_k": {"type": "integer", "minimum": 1},
        "physical_batch_size": {"type": "integer", "minimum": 1, "maximum": 1024},
        "world_slots": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/slot"}},
        "native_observation_union": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "native_control": {"$ref": "#/$defs/native_control"},
        "physical_batch_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "native_world_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "semantic_inputs_sha256",
        "science_ownership_sha256",
        "capability_mask_at_start",
        "world",
        "initialization",
        "seed_bindings",
        "control_bindings",
        "time",
        "control_digest"
      ],
      "properties": {
        "schema_version": {"const": "eiel_science_cuda_v2_native_world_v1"},
        "semantic_inputs_sha256": {"$ref": "#/$defs/digest"},
        "science_ownership_sha256": {"$ref": "#/$defs/digest"},
        "capability_mask_at_start": {"type": "integer", "minimum": 0, "maximum": 127},
        "world": {"type": "object"},
        "initialization": {"type": "object"},
        "seed_bindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
        },
        "control_bindings": {"type": "array", "items": {"type": "object"}},
        "time": {"type": "object"},
        "control_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "native_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capability_mask",
        "control_vector",
        "control_digest"
      ],
      "properties": {
        "schema_version": {"const": "eiel_science_cuda_v2_native_control_v1"},
        "capability_mask": {"type": "integer", "minimum": 0, "maximum": 127},
        "control_vector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutation.enabled"],
          "properties": {"mutation.enabled": {"type": "boolean"}}
        },
        "control_digest": {"$ref": "#/$defs/digest"}
      },
      "oneOf": [
        {
          "properties": {
            "capability_mask": {"const": 95},
            "control_vector": {
              "properties": {"mutation.enabled": {"const": false}}
            }
          }
        },
        {
          "properties": {
            "capability_mask": {"const": 127},
            "control_vector": {
              "properties": {"mutation.enabled": {"const": true}}
            }
          }
        }
      ]
    }
  }
}
